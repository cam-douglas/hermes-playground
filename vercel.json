{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>[^.]+)\\.hermes-playground-green\\.vercel\\.app"
        }
      ],
      "destination": "/projects/:slug/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>[^.]+)\\.hermes-playground-green\\.vercel\\.app"
        }
      ],
      "destination": "/projects/:slug/:path*"
    },
    {
      "source": "/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/:slug((?!hub|runs|projects)[^/]+)",
      "destination": "/projects/:slug/"
    },
    {
      "source": "/:slug((?!hub|runs|projects)[^/]+)/:path*",
      "destination": "/projects/:slug/:path*"
    }
  ]
}
