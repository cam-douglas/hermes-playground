{
  "trailingSlash": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/hasp", "destination": "/projects/hasp" },
    { "source": "/hasp/", "destination": "/projects/hasp" },
    { "source": "/parity", "destination": "/projects/parity" },
    { "source": "/parity/", "destination": "/projects/parity" },
    { "source": "/reveille", "destination": "/projects/reveille" },
    { "source": "/reveille/", "destination": "/projects/reveille" },
    { "source": "/quench", "destination": "/projects/quench" },
    { "source": "/quench/", "destination": "/projects/quench" },
    { "source": "/scrim", "destination": "/projects/scrim" },
    { "source": "/scrim/", "destination": "/projects/scrim" },
    { "source": "/knock", "destination": "/projects/knock" },
    { "source": "/knock/", "destination": "/projects/knock" },
    { "source": "/:slug", "destination": "/projects/:slug" },
    { "source": "/:slug/", "destination": "/projects/:slug" }
  ]
}
