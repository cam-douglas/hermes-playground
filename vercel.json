{
  "trailingSlash": true,
  "cleanUrls": true,
  "routes": [
    { "src": "^/knock/?$", "dest": "/projects/knock/index.html" },
    {
      "src": "^/(?!hub(?:/|$)|projects(?:/|$)|runs(?:/|$)|catalog\\.json)([^/]+)/?$",
      "dest": "/projects/$1/index.html"
    },
    { "handle": "filesystem" }
  ]
}
