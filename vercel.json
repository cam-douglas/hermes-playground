{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hermes-playground-green.vercel.app"
        }
      ],
      "destination": "/hub/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hermes-playground.vercel.app"
        }
      ],
      "destination": "/hub/index.html"
    },
    {
      "source": "/",
      "missing": [
        {
          "type": "host",
          "value": "hermes-playground-green.vercel.app"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "^(?!hermes-playground-green\\.vercel\\.app$)(?<slug>(?!hermes-playground-green$)[^.]+)\\.hermes-playground-green\\.vercel\\.app$"
        }
      ],
      "destination": "/projects/:slug/"
    },
    {
      "source": "/:path*",
      "missing": [
        {
          "type": "host",
          "value": "hermes-playground-green.vercel.app"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "^(?!hermes-playground-green\\.vercel\\.app$)(?<slug>(?!hermes-playground-green$)[^.]+)\\.hermes-playground-green\\.vercel\\.app$"
        }
      ],
      "destination": "/projects/:slug/:path*"
    },
    {
      "source": "/",
      "destination": "/hub/index.html"
    },
    {
      "source": "/knock",
      "destination": "/projects/knock/index.html"
    },
    {
      "source": "/knock/",
      "destination": "/projects/knock/index.html"
    },
    {
      "source": "/:slug((?!hub|runs|projects)[^/]+)",
      "destination": "/projects/:slug/"
    },
    {
      "source": "/:slug((?!hub|runs|projects)[^/]+)/:path*",
      "destination": "/projects/:slug/:path*"
    }
  ]
}
