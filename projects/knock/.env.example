# Knock — permission-gate relay
# Without Slack / GitHub / Linear secrets the app runs in honest demo mode.

# Public URL of this Knock instance (used in Slack buttons and hook wait).
KNOCK_PUBLIC_URL=http://localhost:3100

# Grant TTL in seconds. Default 120. Denied automatically if nobody answers.
KNOCK_TTL_SECONDS=120

# Open a Linear "blocked agent" issue after this many pending seconds. Default 20.
LINEAR_ESCALATE_AFTER_SECONDS=20

# Optional shared secret for hook POSTs (Claude Code PermissionRequest / PreToolUse).
KNOCK_HOOK_SECRET=

# --- Slack (optional) ---
# Bot token + channel. If missing, Slack cards are simulated in the inbox.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# --- GitHub grant ledger (optional) ---
# PAT or GitHub App installation token. Writes a check-run and/or PR comment.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_HEAD_SHA=
GITHUB_PR_NUMBER=

# GitHub App (alternative to GITHUB_TOKEN)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# --- Linear blocked-agent issues (optional) ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_DONE_STATE_ID=

# Optional durable Postgres URL. If unset: SQLite-shaped JSON file locally,
# in-memory + demo seed on Vercel.
DATABASE_URL=
KNOCK_STORE_PATH=data/knock-store.json
