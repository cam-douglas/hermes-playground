# Read-only diagnostic env names from #92662. Unused at page runtime.
# No real secrets. Never put a credential here. Educational diagnostic only.
GANGWAY_GITHUB_ISSUE=https://github.com/anthropics/claude-code/issues/92662
GANGWAY_OS=macOS Darwin 25.4.0 Apple Silicon
GANGWAY_SURFACE=Claude in Chrome / native-host unix socket / MCP tab group
GANGWAY_CLI=2.1.260
GANGWAY_CHROME=152.0.7977.83
GANGWAY_EXTENSION=1.0.91
GANGWAY_NATIVE_HOST=claude --chrome-native-host
GANGWAY_SOCKET=/tmp/claude-mcp-browser-bridge-<user>/<pid>.sock
GANGWAY_SLACK_CHANNEL=#hermes-catalog
GANGWAY_SLACK_WEBHOOK=
SLACK_WEBHOOK=
GANGWAY_CATALOG_HOST=https://hermes-playground-green.vercel.app/gangway/
GANGWAY_GITHUB_TOKEN=
GITHUB_TOKEN=
GANGWAY_LINEAR_KEY=
LINEAR_API_KEY=
